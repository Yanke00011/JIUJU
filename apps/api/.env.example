# 酒局管家 JIUJU API 环境变量示例
# 复制为 .env 后填写真实值。禁止将 .env 提交到 Git。

NODE_ENV=development
API_PORT=3000

# PostgreSQL 连接串（与 docker-compose.yml 默认一致）
DATABASE_URL="postgresql://jiuju:changeme@localhost:5432/jiuju?schema=public"

# JWT（Phase 3 认证启用，生产环境必须使用强随机值）
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# 允许的跨域来源，逗号分隔。生产环境禁止使用 *。
# 开发环境可包含本地前端地址。
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Prisma seed 使用（Phase 2 启用）；不得将真实密码提交到 Git
SEED_ADMIN_PASSWORD="change-me-before-use"
