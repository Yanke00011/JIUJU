# 酒局管家 JIUJU 生产环境变量示例
# 复制为 .env.production 后填写真实值。禁止将 .env.production 提交到 Git。
# docker-compose.prod.yml 会读取本文件。

NODE_ENV=production
API_PORT=3000

# PostgreSQL 连接串（生产应指向 compose 中的 postgres 服务名，或真实数据库地址）
DATABASE_URL="postgresql://jiuju:changeme@postgres:5432/jiuju?schema=public"

# JWT（生产必须使用强随机值，禁止复用开发值；启动时会校验非空）
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# 允许的跨域来源，逗号分隔。生产环境禁止 *，必须明确列出前端域名。
CORS_ORIGINS="https://app.example.com,https://admin.example.com"

# Swagger：生产默认关闭；仅当显式设为 true 时开启。
SWAGGER_ENABLED=false

# 以下变量用于 compose 中的 postgres 服务初始化，需与 DATABASE_URL 一致
POSTGRES_USER=jiuju
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jiuju
